# 360T7 新版全 UBI 布局（127M）
# 分区表（OpenWrt 上游 PR #22797 起）：
#   bl2(1M) ubi(127M, 内含 factory/fip/fit/ubootenv/ubootenv2 卷)
# 需要配套刷入本布局的 preloader.bin 与 bl31-uboot.fip，不能与 108M 布局混刷。

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7-ubi=y
CONFIG_TARGET_PROFILE="DEVICE_qihoo_360t7-ubi"

# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
