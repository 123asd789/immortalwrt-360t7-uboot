# 360T7 custom U-Boot layout（hanwckf/bl-mt798x，108M 大分区）— 默认
# 分区表：bl2(1M) u-boot-env(512K) Factory(2M) fip(2M) ubi(108M @0x580000)
#        stock-config(1M) stock-factory(512K) stock-log(4M)
# 内核/根文件系统放在 UBI 的 kernel/rootfs 卷，U-Boot 通过 ubiblock 启动。
# 产物：*-squashfs-factory.bin（U-Boot 首次刷写）、*-squashfs-sysupgrade.bin（系统内升级）
#
# 由 .github/workflows/build-360t7.yml 在 `make defconfig` 之前复制为 openwrt/.config。

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7-uboot=y
CONFIG_TARGET_PROFILE="DEVICE_qihoo_360t7-uboot"

# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
