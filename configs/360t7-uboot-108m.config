# 360T7 U-Boot 108M 大分区布局（默认）
# 分区表（与 hanwckf/bl-mt798x 的 mt7981_360t7_defconfig 一致）：
#   bl2(1024k) u-boot-env(512k) factory(2M) fip(2M) ubi(108M) stock-config(1M) stock-factory(512k) stock-log(4M)
#
# 由 .github/workflows/build-360t7.yml 在 `make defconfig` 之前复制为 openwrt/.config。

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_PROFILE="DEVICE_qihoo_360t7"

# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

# 可选：如需默认集成其他软件包，可直接追加 CONFIG_PACKAGE_xxx=y
# 或使用 workflow 的 extra_packages 输入。
