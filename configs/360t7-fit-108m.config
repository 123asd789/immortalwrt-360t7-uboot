# 360T7 OpenWrt U-Boot layout（FIT，sysupgrade.itb）
# 适用于刷了 OpenWrt/ImmortalWrt 官方 U-Boot（本仓库 fit 构建的 -bl31-uboot.fip）的设备，
# 与 hanwckf 108M 自定义 U-Boot 不兼容，请勿混刷。
# 分区：bl2(1M) u-boot-env(512K) Factory(2M) fip(2M) ubi(108M @0x580000，fit 卷)

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_qihoo_360t7=y
CONFIG_TARGET_PROFILE="DEVICE_qihoo_360t7"

# LuCI
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
